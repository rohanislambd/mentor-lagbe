# ==========================================
# 🎓 MentorLagbe - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Better-Auth Authentication Settings
# ------------------------------------------
# A secure random 32+ character string used to encrypt session tokens and cookies
# Generate via: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_key_here

# The base URL of the frontend application
# Local Development: http://localhost:3000
# Production: https://your-domain.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------
# MongoDB Atlas Connection URI or local MongoDB connection string
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.mongodb.net/mentor-lagbe?retryWrites=true&w=majority

# ------------------------------------------
# 3. Google OAuth 2.0 Credentials (Optional)
# ------------------------------------------
# Created via Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------
# 4. Image Upload (ImgBB API)
# ------------------------------------------
# API Key from https://api.imgbb.com/ for profile avatar and tuition banner uploads
NEXT_PUBLIC_IMAGEBB_API_KEY=your_imgbb_api_key_here

# ------------------------------------------
# 5. Backend Server API Base URL
# ------------------------------------------
# Express server API URL (without trailing slash)
# Local Server: http://localhost:5000
# Production Server: https://mentor-lagbe-server.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://mentor-lagbe-server.vercel.app
